{%- macro sub_buttons(x) -%}
<a class="sub-btn google" href="https://calendar.google.com/calendar/render?cid={{ x.gcal_cid }}" target="_blank" rel="noopener" data-umami-event="subscribe-google" data-umami-event-line="{{ x.name }}"><img src="/icons/googlecalendar.svg" width="15" height="15" alt="" style="margin-right:.35em;flex-shrink:0">Google Calendar</a>
{#- -#}
<a class="sub-btn webcal" href="{{ x.webcal_url }}" data-umami-event="subscribe-webcal" data-umami-event-line="{{ x.name }}"><img src="/icons/apple.svg" width="16" height="16" alt="" style="margin-right:.35em;flex-shrink:0">iCal / webcal</a>
{#- -#}
<a class="sub-btn outlook" href="https://outlook.live.com/calendar/0/addfromweb?url={{ x.encoded_url }}" target="_blank" rel="noopener" data-umami-event="subscribe-outlook" data-umami-event-line="{{ x.name }}"><img src="/icons/outlook.svg" width="16" height="16" alt="" style="margin-right:.35em;flex-shrink:0">Outlook</a>
{#- -#}
<a class="sub-btn o365" href="https://outlook.office.com/calendar/addfromweb?url={{ x.encoded_url }}" target="_blank" rel="noopener" data-umami-event="subscribe-o365" data-umami-event-line="{{ x.name }}"><img src="/icons/office365.svg" width="15" height="15" alt="" style="margin-right:.35em;flex-shrink:0">Office 365</a>
{#- -#}
<button class="sub-btn copy" onclick="copyUrl('{{ x.ics_url }}',this)" data-umami-event="copy-url" data-umami-event-line="{{ x.name }}"><img src="/icons/copy.svg" width="14" height="14" alt="" style="margin-right:.35em;flex-shrink:0">Copier le lien</button>
{%- endmacro -%}
{%- macro badge_class(network) -%}badge{% if network == "RapidTransit" %} badge-rer{% endif %}{%- endmacro -%}
{%- macro badge(line, classes='', extra_style='') -%}
{%- if line.network == "Tramway" -%}
{%- set has_suffix = line.name|length == 3 and line.name[-1] in 'abcdefghijklmnopqrstuvwxyz' -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 283.46 283.46" class="badge badge-tram{% if classes %} {{ classes }}{% endif %}"{% if extra_style %} style="{{ extra_style }}"{% endif %} role="img" aria-label="Tram {{ line.name }}"><path fill="#fff" d="M0,28.35h283.46v226.76H0z"/><rect fill="{{ line.bg }}" width="283.46" height="42.52" rx="14.17"/><rect fill="{{ line.bg }}" width="283.46" height="42.52" rx="14.17" y="240.94"/><text x="141.73" y="141.73" text-anchor="middle" dominant-baseline="central" fill="#25303B" font-family="system-ui,-apple-system,Arial,sans-serif" font-weight="800" font-size="140">{% if has_suffix %}{{ line.name[:2] }}<tspan font-size="95" dy="-15">{{ line.name[-1] }}</tspan>{% else %}{{ line.name }}{% endif %}</text></svg>
{%- else -%}
<span class="{{ badge_class(line.network) }}{% if classes %} {{ classes }}{% endif %}" style="background:{{ line.bg }};color:{{ line.fg }}{% if extra_style %};{{ extra_style }}{% endif %}">{{ line.label_html|safe }}</span>
{%- endif -%}
{%- endmacro -%}
{%- macro disrupted_grid(lines) -%}
<div class="lines-grid">{% for line in lines %}
    <div class="line-row" data-line="{{ line.name }}">
      <div class="line-header">
        {{ badge(line) }}
        <div class="line-vsep"></div>
        <div class="line-actions">{{ sub_buttons(line) }}</div>
      </div>
      {% if line.card_count == 0 -%}<p class="quiet">Aucune interruption prévue, mais cela pourrait arriver dans le futur. Abonnez-vous pour ne pas les manquer.</p>{%- else -%}<button class="dis-btn" data-dialog="{{ line.dialog_id }}" data-umami-event="accordion-open" data-umami-event-line="{{ line.name }}"><span style="font-size:.8em">▶</span> {{ line.label_text }}</button>
    <dialog id="{{ line.dialog_id }}" class="dis-dialog">
      <div class="dis-dialog-header">
        {{ badge(line, extra_style="width:2rem;height:2rem;font-size:1.2rem;flex-shrink:0") }}
        <span class="dis-dialog-subtitle" style="margin:0;flex:1">{{ line.label_text }}</span>
        <button class="dis-close" autofocus onclick="this.closest('dialog').close()">✕</button>
      </div>
      <div class="dis-dialog-body"><div class="cards">{% for card in line.cards %}
          <div class="dis-card">
            <div class="card-title">{{ card.title }}</div>
            {% for p in card.periods -%}<div class="period"><span class="row-icon">📅</span>{{ p }}</div>{%- endfor %}{% if card.stops %}<div class="stops"><span class="row-icon"><img src="/favicon/favicon.svg" width="16" height="16" alt=""></span>{{ card.stops }}</div>{% endif %}{% if card.message %}<div class="message">{{ card.message }}</div>{% endif %}
          </div>{% endfor %}</div></div>
    </dialog>{%- endif %}
    </div>{% endfor %}</div>
{%- endmacro -%}
{%- macro mode_expand(lines, icon_src, icon_alt, note_text) -%}
<details class="rer-expand">
  <summary><span class="rer-summary-text"><span class="rer-text-long">Cliquez ici pour les</span><span class="rer-text-short">Voir</span> lignes de</span><span class="rer-summary-badges"><img src="{{ icon_src }}" class="rer-inline-icon" alt="{{ icon_alt }}" width="24" height="24">{% for line in lines %}{{ badge(line, classes="badge-sm") }}{% endfor %}</span></summary>
  {% if note_text %}<p class="rer-note">{{ note_text }}</p>{% endif %}
  {{ caller() }}
</details>
{%- endmacro -%}
{%- set rer_note = "Les lignes de RER sont énormément impactées par les travaux du réseau. Abonnez-vous aux calendriers si l'information vous intéresse tout de même." -%}
{%- macro calm_grid(lines) -%}
<div class="lines-grid">{% for line in lines %}
    <div class="line-row">
      <div class="line-header">
        {{ badge(line) }}
        <div class="line-vsep"></div>
        <div class="line-actions">{{ sub_buttons(line) }}</div>
      </div>
    </div>{% endfor %}</div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Travaux Métro</title>
  <meta name="description" content="Calendrier des interruptions et travaux planifiés du métro parisien, mis à jour quotidiennement. Abonnez-vous à votre ligne.">
  <meta name="theme-color" content="#003CA6">
  <link rel="canonical" href="https://travauxmetro.fr/">
  <meta property="og:title" content="Travaux Métro">
  <meta property="og:description" content="Calendrier des interruptions et travaux planifiés du métro parisien, mis à jour quotidiennement. Abonnez-vous à votre ligne.">
  <meta property="og:url" content="https://travauxmetro.fr/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Travaux Métro">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:image" content="https://travauxmetro.fr/assets/og-image-cream.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Travaux Métro">
  <meta name="twitter:description" content="Calendrier des interruptions et travaux planifiés du métro parisien, mis à jour quotidiennement. Abonnez-vous à votre ligne.">
  <meta name="twitter:image" content="https://travauxmetro.fr/assets/og-image-cream.png">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Travaux Métro Paris",
    "url": "https://travauxmetro.fr",
    "description": "Calendrier des interruptions et travaux planifiés du métro parisien, mis à jour quotidiennement. Abonnez-vous à votre ligne.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
    "inLanguage": "fr",
    "dateModified": "{{ fetched_at_date }}"
  }
  </script>
  {{ favicon }}
  {{ umami }}
  <style>
{{ css_inline }}  </style>
</head>
<body>
  <h1 style="display:flex;align-items:center;gap:.35em;line-height:.95"><svg xmlns="http://www.w3.org/2000/svg" width="2.43em" height="2.43em" viewBox="-1.5 -1.5 27 27" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><g transform="rotate(90 12 12) translate(12 12) scale(1.1) translate(-12 -12)"><path d="M2 17 17 2"/><path d="m2 14 8 8"/><path d="m5 11 8 8"/><path d="m8 8 8 8"/><path d="m11 5 8 8"/><path d="m14 2 8 8"/><path d="M7 22 22 7"/></g><g transform="translate(12 12) scale(.6) translate(-12 -12)"><path stroke="#222" stroke-width="2.5" stroke-opacity="1" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/><path stroke="#E6B800" stroke-width="1" fill="#222" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></g></svg><span>Travaux<br><span style="display:block;padding-left:.09em"><span style="color:#E6B800;text-shadow:-2px -2px 0 #222,2px -2px 0 #222,-2px 2px 0 #222,2px 2px 0 #222,0 -2px 0 #222,0 2px 0 #222,-2px 0 0 #222,2px 0 0 #222,-1px -2px 0 #222,1px -2px 0 #222,-2px -1px 0 #222,2px -1px 0 #222,-2px 1px 0 #222,2px 1px 0 #222,-1px 2px 0 #222,1px 2px 0 black;letter-spacing:+.05em">M</span>étro</span></span></h1>
  <p class="subtitle" style="margin-top:2rem">Interruptions et travaux planifiés par les opérateurs du réseau.</br>Abonnez-vous au calendrier d'interruptions de votre ligne de métro parisien.</p>

  <div class="intro">
    Cliquez sur <strong>le fournisseur de calendrier de votre choix</strong> pour vous abonner en un clic.</br>
    Le calendrier se met à jour <strong>automatiquement</strong> lorsque de nouvelles interruptions sont prévues sur le réseau.
    <details style="margin-top:.6rem">
      <summary style="color:#888;font-weight:500">Comment ça marche ?</summary>
      <p style="margin:.5rem 0 0;font-size:.88em;color:#555">
        Un abonnement <a href="https://fr.wikipedia.org/wiki/ICalendar" target="_blank" rel="noopener" style="color:#555">iCalendar (aussi abrégé iCal)</a> est un calendrier en lecture seule hébergé sur Internet que votre application de calendrier récupère à intervale régulier.
        Les événements apparaissent directement dans votre agenda, sans compte supplémentaire à créer.
        Dès que de nouvelles interruptions sont prévues et publiées par Île-de-France Mobilités, elles se synchronisent automatiquement.
      </p>
    </details>
  </div>

  <p class="contact-hint">Une question, une suggestion, une erreur à remonter&nbsp;? <span style="white-space:nowrap">→ <a href="mailto:{{ contact_email }}">{{ contact_email }}</a></span></p>

  {% if metro_disrupted or rer_disrupted %}
  <section>
    <h2 class="section-title">Lignes interrompues</h2>
    <p class="section-note">Les opérateurs du réseau ont prévu des interruptions dues aux travaux sur ces lignes.</p>
    {% if metro_disrupted %}{{ disrupted_grid(metro_disrupted) }}{% endif %}
    {% if metro_disrupted and rer_disrupted %}<hr class="network-sep">{% endif %}
    {% if rer_disrupted %}{% call mode_expand(rer_all, "/icons/rer.svg", "RER", rer_note) %}{{ disrupted_grid(rer_disrupted) }}{% endcall %}{% endif %}
    {% if (metro_disrupted or rer_disrupted) and tram_disrupted %}<hr class="network-sep">{% endif %}
    {% if tram_disrupted %}{% call mode_expand(tram_all, "/icons/tram.svg", "Tramway", "") %}{{ disrupted_grid(tram_disrupted) }}{% endcall %}{% endif %}
  </section>{% else %}<p class="quiet" style="margin-bottom:1.5rem">Aucune interruption prévue sur le réseau.</p>{% endif %}
  {% if metro_calm or rer_calm or tram_calm %}
  <section>
    <h2 class="section-title">Autres lignes</h2>
    <p class="section-note">Aucune interruption prévue sur ces lignes. Abonnez-vous pour être notifié automatiquement si cela change.</p>
    {% if metro_calm %}{{ calm_grid(metro_calm) }}{% endif %}
    {% if metro_calm and rer_calm %}<hr class="network-sep">{% endif %}
    {% if rer_calm %}{% call mode_expand(rer_all, "/icons/rer.svg", "RER", rer_note) %}{{ calm_grid(rer_calm) }}{% endcall %}{% endif %}
    {% if (metro_calm or rer_calm) and tram_calm %}<hr class="network-sep">{% endif %}
    {% if tram_calm %}{% call mode_expand(tram_all, "/icons/tram.svg", "Tramway", "") %}{{ calm_grid(tram_calm) }}{% endcall %}{% endif %}
  </section>{% endif %}

  <section>
    <h2 class="section-title">Toutes les lignes</h2>
    <p class="section-note">Un seul abonnement pour suivre toutes les interruptions du réseau en même temps.</p>
    <div class="line-row">
      <div class="line-header">
        <div class="all-badges">{% for line in metro_all %}{% if not loop.first %} {% endif %}{{ badge(line) }}{% endfor %}</div>
        <div class="line-vsep"></div>
        <div class="line-actions">{{ sub_buttons(all_metro_sub) }}</div>
      </div>
    </div>
    {% if rer_all %}<hr class="network-sep">
    {% call mode_expand(rer_all, "/icons/rer.svg", "RER", rer_note) %}
    <div class="line-row">
      <div class="line-header">
        <div class="all-badges">{% for line in rer_all %}{% if not loop.first %} {% endif %}{{ badge(line) }}{% endfor %}</div>
        <div class="line-vsep"></div>
        <div class="line-actions">{{ sub_buttons(all_rer_sub) }}</div>
      </div>
    </div>
    {% endcall %}{% endif %}
    {% if tram_all %}<hr class="network-sep">
    {% call mode_expand(tram_all, "/icons/tram.svg", "Tramway", "") %}
    <div class="line-row">
      <div class="line-header">
        <div class="all-badges">{% for line in tram_all %}{% if not loop.first %} {% endif %}{{ badge(line) }}{% endfor %}</div>
        <div class="line-vsep"></div>
        <div class="line-actions">{{ sub_buttons(all_tram_sub) }}</div>
      </div>
    </div>
    {% endcall %}{% endif %}
  </section>

  <footer>
    <div>Source : <a href="https://prim.iledefrance-mobilites.fr">Île-de-France Mobilités (PRIM)</a></div>
    <div><a href="https://github.com/ggrelet/travauxmetro.fr"><img src="/icons/github.svg" width="14" height="14" alt="GitHub" style="vertical-align:middle;margin-right:.25em;margin-bottom:2px">code source</a></div>
    <div>Dernière mise à jour : <span style="white-space:nowrap">{{ date_str }} à {{ time_str }}</span></div>
    <div>→ <a href="mailto:{{ contact_email }}">{{ contact_email }}</a></div>
  </footer>
  <script>
{{ js_inline }}  </script>
</body>
</html>
